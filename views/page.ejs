<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/normalize.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/main-blocks.css">
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <div class="container">
            <h1 class="section-title" id="pageTitle"><%= title %></h1>
            <div id="pageContent"></div>
            <div id="pageBlocks"></div>
        </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main-blocks.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', async function() {
        // Получаем slug страницы из шаблона
        const pageSlug = "<%= typeof slug !== 'undefined' ? slug : '' %>";
        if (!pageSlug) return;

        // Загружаем основной контент страницы
        try {
            const response = await fetch(`/api/pages/${pageSlug}`);
            if (response.ok) {
                const page = await response.json();
                // Обновляем заголовок
                const titleElement = document.getElementById('pageTitle');
                if (titleElement && page.title) {
                    titleElement.textContent = page.title;
                }
                // Обновляем контент
                const contentDiv = document.getElementById('pageContent');
                if (contentDiv) {
                    contentDiv.innerHTML = page.content || '';
                }
            }
        } catch (error) {
            console.error('Ошибка при загрузке контента страницы:', error);
        }

        // Загружаем блоки страницы
        initializePageBlocks(pageSlug);
    });
    </script>
    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
    <script src="/js/main.js"></script>
</body>
</html> 